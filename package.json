{
  "name": "pospe",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-Tenant POS Billing & Inventory Management SaaS - monorepo",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "database"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prisma:generate": "npm run generate --workspace=database",
    "prisma:migrate": "npm run migrate --workspace=database"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20"
  }
}
