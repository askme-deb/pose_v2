{
  "name": "@pospe/desktop-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5175\" \"wait-on tcp:5175 && electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "npm run build && electron-builder",
    "lint": "eslint . --ext ts,tsx",
    "clean": "rm -rf dist release node_modules .turbo",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || exit 0"
  },
  "dependencies": {
    "@pospe/ui-library": "*",
    "@pospe/api-client": "*",
    "@pospe/authentication": "*",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "concurrently": "^9.0.1",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.pospe.desktoppos",
    "productName": "PosPe Desktop POS",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "output": "release" },
    "asarUnpack": ["**/node_modules/better-sqlite3/**"]
  }
}
