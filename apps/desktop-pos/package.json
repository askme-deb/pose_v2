{
  "name": "@pospe/desktop-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5175\" \"wait-on tcp:5175 && electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "npm run build && electron-builder",
    "lint": "eslint . --ext ts,tsx",
    "clean": "rm -rf dist release node_modules .turbo"
  },
  "dependencies": {
    "@pospe/ui-library": "*",
    "@pospe/api-client": "*",
    "@pospe/authentication": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.pospe.desktoppos",
    "productName": "PosPe Desktop POS",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "output": "release" }
  }
}
