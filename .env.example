# --- Shared / Root ---
NODE_ENV=development

# --- Database / infra (ports match docker/docker-compose.yml) ---
DATABASE_URL=postgresql://pospe:pospe@localhost:5433/pospe?schema=public
REDIS_URL=redis://localhost:6380
# Elasticsearch runs with security enabled; credentials go in the URL.
ELASTICSEARCH_URL=http://elastic:pospe-elastic@localhost:9200

# --- Auth ---
# Generate real secrets with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Platform operator created by `npm run seed --workspace=database`.
SUPER_ADMIN_EMAIL=superadmin@pospe.com
SUPER_ADMIN_PASSWORD=change-me-super-admin

# --- Storage (S3-compatible: MinIO locally, S3/R2 in production) ---
# Leave S3_* blank to store uploads on local disk (dev only).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pospe-uploads
S3_ACCESS_KEY=pospe
S3_SECRET_KEY=pospe-minio-secret
S3_PUBLIC_URL=http://localhost:9000/pospe-uploads

# --- Payments (India) — only configured gateways are offered ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_URL=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox
PHONEPE_CALLBACK_URL=
PHONEPE_REDIRECT_URL=

# --- Notifications ---
# MailHog local SMTP catcher (docker/docker-compose.yml) — no auth needed.
# View received mail (OTP codes, invites, reports) at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PosPe" <no-reply@pospe.local>
# SMS + WhatsApp via Twilio (leave blank to send email only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# --- Observability ---
# Sentry error tracking; blank disables it.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Service Ports ---
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
BILLING_SERVICE_PORT=4002
INVENTORY_SERVICE_PORT=4003
PURCHASE_SERVICE_PORT=4004
SALES_SERVICE_PORT=4005
PAYMENT_SERVICE_PORT=4006
NOTIFICATION_SERVICE_PORT=4007
SUBSCRIPTION_SERVICE_PORT=4008
REPORTING_SERVICE_PORT=4009
SYNCHRONIZATION_SERVICE_PORT=4010
