# --- Shared / Root ---
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://pospe:pospe@localhost:5432/pospe?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# --- Auth ---
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Storage ---
S3_ENDPOINT=
S3_BUCKET=pospe-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Payments (India) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_API_KEY=
WHATSAPP_API_KEY=

# --- Service Ports ---
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
BILLING_SERVICE_PORT=4002
INVENTORY_SERVICE_PORT=4003
PURCHASE_SERVICE_PORT=4004
SALES_SERVICE_PORT=4005
PAYMENT_SERVICE_PORT=4006
NOTIFICATION_SERVICE_PORT=4007
SUBSCRIPTION_SERVICE_PORT=4008
REPORTING_SERVICE_PORT=4009
SYNCHRONIZATION_SERVICE_PORT=4010
