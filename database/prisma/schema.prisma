// PosPe — core multi-tenant schema (starter).
// Each business-domain service (billing, inventory, purchase, sales, ...)
// extends this schema with its own models as it's built out.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- SaaS / Tenant management ----------

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum TenantRegion {
  MUMBAI
  VIRGINIA
  FRANKFURT
}

model Tenant {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  plan         SubscriptionPlan  @default(STARTER)
  status       TenantStatus      @default(TRIAL)
  whiteLabel   Boolean           @default(false)
  customDomain String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Platform/superadmin provisioning metadata — not read by any operational
  // service (those only ever resolve the single seeded demo tenant today),
  // only by the superadmin SaaS management pages.
  ownerName      String?
  ownerEmail     String?
  storesLimit    Int          @default(10)
  storageUsedGB  Int          @default(0)
  storageLimitGB Int          @default(250)
  dbInstancePod  String?
  region         TenantRegion @default(MUMBAI)

  stores           Store[]
  profile          TenantProfile?
  branding         TenantBranding?
  users            User[]
  products         Product[]
  brands           Brand[]
  stockAdjustments StockAdjustment[]
  customers        Customer[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]
  warehouses       Warehouse[]
  warehouseTransfers WarehouseTransfer[]
  gstReturns       GstReturn[]
  rbacRoles        RbacRole[]
  auditLogs        AuditLog[]
  cnameDomains     CnameDomain[]
  platformInvoices PlatformInvoice[]
  syncDevices      SyncDevice[]
  syncConflicts    SyncConflict[]
  salesQuotes        SalesQuote[]
  deliveryChallans   DeliveryChallan[]
  creditNotes        CreditNote[]
  debitNotes         DebitNote[]
  goodsReceivedNotes GoodsReceivedNote[]
  purchaseReturns    PurchaseReturn[]
  supplierPayments   SupplierPayment[]
  productBatches     ProductBatch[]
  productSerials     ProductSerial[]
  productBundleItems ProductBundleItem[]
  warehouseRacks         WarehouseRack[]
  warehouseRackItems     WarehouseRackItem[]
  warehouseDamageReports WarehouseDamageReport[]
  customerWalletTransactions CustomerWalletTransaction[]
  membershipPlans            MembershipPlan[]
  reportSchedules            ReportSchedule[]

  @@map("tenants")
}

enum UserRole {
  // Platform operator (manages every tenant). Belongs to the platform's own
  // tenant row purely to satisfy User.tenantId.
  SUPER_ADMIN
  TENANT_OWNER
  BRANCH_ADMIN
  STORE_MANAGER
  CASHIER
  ACCOUNTANT
  INVENTORY_MANAGER
  SALES_EXECUTIVE
}

model User {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id])
  // The custom RBAC role built on the Roles & Security page — richer than the
  // fixed UserRole enum below (which stays for coarse-grained checks
  // elsewhere), since the whole point of that page is tenant-defined roles
  // with a per-module permission matrix.
  rbacRoleId     String?
  rbacRole       RbacRole? @relation(fields: [rbacRoleId], references: [id])
  name           String
  email          String
  passwordHash   String
  // Set only for counter staff who use the POS terminal's 4-digit quick-login
  // pad instead of the email/password form — null for everyone else.
  pinHash        String?
  role           UserRole
  twoFaEnabled   Boolean   @default(false)
  // Base32 TOTP secret, set by POST /2fa/setup once the user starts
  // enrolling — null until then, cleared again on disable.
  twoFaSecret    String?
  isActive       Boolean   @default(true)
  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  // Embedded in refresh tokens; bumping it (logout, password change/reset,
  // deactivation) revokes every refresh token issued before.
  tokenVersion        Int       @default(0)
  // Null until the owner confirms the emailed code after self-serve signup.
  emailVerifiedAt     DateTime?
  // Brute-force lockout for password and PIN logins.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  otps AuthOtp[]

  @@unique([tenantId, email])
  @@map("users")
}

model RbacRole {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  title       String
  code        String
  accessScope String
  colorTheme  String   @default("teal")
  description String?
  isSystem    Boolean  @default(false)
  // { pos: {view,create,edit,delete,approve,export}, inventory: {...}, finance: {...}, crm: {...} }
  permissions Json
  createdAt   DateTime @default(now())

  users User[]

  @@unique([tenantId, code])
  @@map("rbac_roles")
}

enum AuditRiskRating {
  LOW
  MEDIUM
  HIGH
}

model AuditLog {
  id         String          @id @default(cuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  timestamp  DateTime        @default(now())
  actor      String
  eventType  String
  details    String
  ipAddress  String?
  riskRating AuditRiskRating @default(LOW)

  @@map("audit_logs")
}

// ---------- Store / Warehouse ----------

enum BranchType {
  FLAGSHIP
  EXPRESS
  CENTRAL_WAREHOUSE
}

model Store {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  name      String
  code      String?
  type      BranchType @default(FLAGSHIP)
  manager   String?
  phone     String?
  isPrimary Boolean    @default(false)
  printers  Int        @default(1)
  address   String?
  gstin     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  users            User[]
  invoices         Invoice[]
  stockItems       StockItem[]
  syncDevices      SyncDevice[]
  syncConflicts    SyncConflict[]
  salesQuotes      SalesQuote[]
  deliveryChallans DeliveryChallan[]
  creditNotes      CreditNote[]
  debitNotes       DebitNote[]

  @@map("stores")
}

enum AuthOtpPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// One-time 6-digit codes emailed for password reset and signup email
// verification. Only a bcrypt hash of the code is stored.
model AuthOtp {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    AuthOtpPurpose
  codeHash   String
  attempts   Int            @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([userId, purpose])
  @@map("auth_otps")
}

// ---------- Tenant business profile / settings ----------
// Split out from Tenant rather than adding ~20 columns directly to it — Tenant
// is queried by every service (resolveTenantId), while this is purely
// display/config data for the settings page. One row per tenant.

model TenantProfile {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  registeredName      String
  tagline             String?
  logoUrl             String?
  retailCategory      String   @default("supermarket")
  cin                 String?
  yearEstablished     Int?
  supportEmail        String?
  helplinePhone       String?
  hqAddress           String?
  gstin               String?
  pan                 String?
  stateCode           String?
  defaultTaxSlab      Int      @default(18)
  invoicePrefix       String   @default("INV-")
  nextInvoiceNumber   Int      @default(1)
  currencySymbol      String   @default("₹")
  financialYearStart  String   @default("April")
  ewayBillThreshold   Int      @default(50000)
  receiptHeader       String?
  receiptSubHeader    String?
  receiptFooter       String?
  receiptReturnPolicy String?
  receiptPaperWidth   String   @default("80mm")
  receiptShowUpiQr    Boolean  @default(true)
  razorpayKeyId       String?
  whatsappPhoneId     String?
  updatedAt           DateTime @updatedAt

  @@map("tenant_profiles")
}

// ---------- Superadmin: white-label branding, custom domains, SaaS billing ----------
// TenantBranding is split out from Tenant for the same reason as TenantProfile:
// purely display/config data for the superadmin white-label page, one row per tenant.

model TenantBranding {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  appTitle      String?
  faviconUrl    String?
  logoUrl       String?
  accentColor   String   @default("#2563eb")
  fontFamily    String   @default("Plus Jakarta Sans")
  customCss     String?
  smtpFromLabel String?
  smtpHost      String?
  updatedAt     DateTime @updatedAt

  @@map("tenant_branding")
}

model CnameDomain {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  cnameDomain          String   @unique
  edgeIngressTarget    String   @default("ingress-mumbai-01.apexpos.com")
  sslSlaStatus         String   @default("Let's Encrypt TLS 1.3")
  dnsPropagationStatus String   @default("Propagated (5ms)")
  createdAt            DateTime @default(now())

  @@map("cname_domains")
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  CASHFREE
  PHONEPE
}

enum PlatformInvoiceStatus {
  PAID
  PENDING
  FAILED
}

model PlatformInvoice {
  id         String                @id @default(cuid())
  tenantId   String
  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  plan       SubscriptionPlan
  gateway    PaymentGateway
  gatewayRef String
  amountINR  Int
  status     PlatformInvoiceStatus @default(PAID)
  issuedAt   DateTime              @default(now())

  @@map("platform_invoices")
}

// ---------- Inventory ----------

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  gstRate     Decimal   @default(0) @db.Decimal(5, 2)
  description String?
  imageUrl    String?
  products    Product[]

  @@map("categories")
}

model Brand {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  countryOfOrigin String?
  // Simple scalar array rather than a join table — matches the current UI's
  // flat multi-select and keeps this in step with the Category model's
  // similarly minimal shape. Revisit if brand/category start needing more
  // than an id list (ordering, per-category metadata, etc).
  categoryIds     String[] @default([])
  createdAt       DateTime @default(now())

  @@map("brands")
}

model Product {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  name       String
  sku        String
  barcode    String?
  hsnCode    String?
  unit       String   @default("PCS")
  mrp        Decimal  @default(0) @db.Decimal(12, 2)
  price      Decimal  @default(0) @db.Decimal(12, 2)
  costPrice  Decimal  @default(0) @db.Decimal(12, 2)
  gstRate    Decimal  @default(0) @db.Decimal(5, 2)
  imageUrl   String?
  // Single-location stock for now (matches the current UI, which has no multi-branch
  // stock breakdown yet). The StockItem model below already supports per-store
  // allocation for when that UI is built; it's just not wired up to this field yet.
  stockQty     Int      @default(0)
  minThreshold Int      @default(0)
  // Off by default — most products track neither. A product with either flag
  // set opts into the receiving/selling flows those features add; a bundle
  // carries no stock of its own (see ProductBundleItem) and is excluded from
  // its own stockQty guard the way a normal SKU isn't.
  trackBatches Boolean  @default(false)
  trackSerials Boolean  @default(false)
  isBundle     Boolean  @default(false)
  createdAt  DateTime @default(now())

  stockItems              StockItem[]
  invoiceItems            InvoiceItem[]
  stockAdjustments        StockAdjustment[]
  purchaseOrderItems      PurchaseOrderItem[]
  warehouseTransferItems  WarehouseTransferItem[]
  salesQuoteItems         SalesQuoteItem[]
  deliveryChallanItems    DeliveryChallanItem[]
  creditNoteItems         CreditNoteItem[]
  goodsReceivedNoteItems  GoodsReceivedNoteItem[]
  purchaseReturnItems     PurchaseReturnItem[]
  batches                 ProductBatch[]
  serials                 ProductSerial[]
  bundleComponents        ProductBundleItem[] @relation("BundleComponents")
  partOfBundles           ProductBundleItem[] @relation("ComponentOfBundles")
  warehouseRackItems      WarehouseRackItem[]
  warehouseDamageReports  WarehouseDamageReport[]

  @@unique([tenantId, sku])
  @@map("products")
}

enum AdjustmentAction {
  ADD
  SUBTRACT
}

enum AdjustmentStatus {
  PENDING
  APPROVED
}

model StockAdjustment {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  productId   String
  product     Product          @relation(fields: [productId], references: [id])
  action      AdjustmentAction
  qty         Int
  reasonCode  String
  auditor     String
  valueImpact Decimal          @default(0) @db.Decimal(12, 2)
  status      AdjustmentStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@map("stock_adjustments")
}

model StockItem {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(0)
  reorderAt Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([storeId, productId])
  @@map("stock_items")
}

// ---------- Customers / Suppliers ----------

enum CustomerTier {
  STANDARD
  SILVER
  GOLD
  VIP_DIAMOND
}

model Customer {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  name          String
  phone         String?
  email         String?
  tier          CustomerTier @default(STANDARD)
  loyaltyPoints Int          @default(0)
  createdAt     DateTime     @default(now())

  // Store-credit balance — the running total; every movement is a
  // CustomerWalletTransaction row so the balance is always reconstructable.
  walletBalance Decimal   @default(0) @db.Decimal(12, 2)
  dateOfBirth   DateTime?
  // Set the day the birthday cron actually credits the bonus, so the same
  // customer can't be paid twice in one year if the job re-runs.
  lastBirthdayOfferAt DateTime?

  membershipPlanId String?
  membershipPlan   MembershipPlan? @relation(fields: [membershipPlanId], references: [id])

  invoices             Invoice[]
  salesQuotes          SalesQuote[]
  deliveryChallans     DeliveryChallan[]
  walletTransactions   CustomerWalletTransaction[]

  @@map("customers")
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  contactPerson String?
  phone     String?
  email     String?
  gstin     String?
  createdAt DateTime @default(now())

  purchaseOrders     PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]
  purchaseReturns    PurchaseReturn[]
  supplierPayments   SupplierPayment[]

  @@map("suppliers")
}

enum PoPaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PurchaseOrderStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  poNumber             String
  totalAmount          Decimal             @default(0) @db.Decimal(12, 2)
  expectedDeliveryDate DateTime
  paymentStatus        PoPaymentStatus     @default(UNPAID)
  orderStatus          PurchaseOrderStatus @default(PENDING)
  createdAt            DateTime            @default(now())

  items               PurchaseOrderItem[]
  goodsReceivedNotes  GoodsReceivedNote[]
  purchaseReturns     PurchaseReturn[]
  supplierPayments    SupplierPayment[]

  @@unique([tenantId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  qty             Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  // Accumulates across every GRN raised against this line — lets the PO's
  // status reflect a partial delivery instead of only "pending" or "fully
  // received" like it used to.
  receivedQty     Int           @default(0)

  @@map("purchase_order_items")
}

// ---------- Billing ----------

enum InvoiceStatus {
  DRAFT
  HELD
  PAID
  PARTIALLY_PAID
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  CASH
  SPLIT
}

model Invoice {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  // Snapshot of the billed name at sale time — real receipts print this even for
  // walk-in customers with no CRM record, and it shouldn't retroactively change
  // if the linked Customer is later renamed.
  customerName  String        @default("Walk-in Customer")
  // Null for a HELD bill — a real sequential number is only ever allocated by
  // sales-service's checkout, at the moment a bill actually gets paid.
  // Postgres treats multiple NULLs as distinct under the unique constraint
  // below, same reasoning already used for idempotencyKey.
  invoiceNumber String?
  status        InvoiceStatus @default(DRAFT)
  paymentMethod PaymentMethod @default(CASH)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  // Invoice-level discount, applied per line before GST (tax is on the
  // post-discount value). total = subtotal - discountTotal + taxTotal.
  discountTotal Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  // The user who rang up the sale (null for system/back-office paths) —
  // feeds the cashier leaderboard.
  createdById         String?
  // Exactly what checkout credited, so a refund can reverse it precisely.
  loyaltyPointsEarned Int       @default(0)
  refundedAt          DateTime?
  // Client-generated key for safe retry of a sale that was queued offline —
  // null for every other caller. Postgres treats multiple NULLs as distinct,
  // so non-idempotent callers never collide with each other here.
  idempotencyKey String?       @unique
  // The next two only carry meaning while status is HELD — the cashier's
  // suspend note/label, and the discount they'd picked before holding.
  // Once a held bill is recalled, sales-service's checkout re-derives real
  // totals from scratch (as it already does for a fresh cart) and these are
  // discarded, not carried onto the paid invoice.
  label            String?
  heldDiscountPercent Decimal?   @db.Decimal(5, 2)

  items    InvoiceItem[]
  payments Payment[]
  convertedFromQuotes    SalesQuote[]
  linkedDeliveryChallans DeliveryChallan[]
  creditNotes            CreditNote[]
  debitNotes             DebitNote[]
  soldSerials            ProductSerial[]
  walletTransactions     CustomerWalletTransaction[]

  @@unique([storeId, invoiceNumber])
  @@index([storeId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  gstRate   Decimal @db.Decimal(5, 2)
  total     Decimal @db.Decimal(12, 2)

  @@map("invoice_items")
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id               String         @id @default(cuid())
  invoiceId        String
  invoice          Invoice        @relation(fields: [invoiceId], references: [id])
  gateway          PaymentGateway @default(RAZORPAY)
  gatewayOrderId   String?        @unique
  gatewayPaymentId String?        @unique
  amount           Decimal        @db.Decimal(12, 2)
  status           PaymentStatus  @default(CREATED)
  refundedAmount   Decimal        @default(0) @db.Decimal(12, 2)
  gatewayRefundId  String?
  // Held-bill completion bookkeeping: a captured payment whose bill hasn't
  // been turned into a real invoice yet is retried until it is.
  completionAttempts  Int     @default(0)
  lastCompletionError String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("payments")
}

enum GstFormType {
  GSTR1
  GSTR3B
}

enum GstFilingStatus {
  PENDING
  FILED
}

model GstReturn {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  formType       GstFormType
  periodMonth    DateTime
  billedTurnover Decimal         @default(0) @db.Decimal(14, 2)
  taxLiability   Decimal         @default(0) @db.Decimal(14, 2)
  arn            String?
  status         GstFilingStatus @default(PENDING)
  createdAt      DateTime        @default(now())

  @@unique([tenantId, formType, periodMonth])
  @@map("gst_returns")
}

// ---------- Warehouse logistics ----------
// Transfers move stock between facilities, not in/out of the tenant's total
// inventory (unlike a purchase-order receipt or a sales refund), so there's no
// Product.stockQty mutation here — nothing in this schema tracks per-warehouse
// stock yet (StockItem above is Store-scoped, a different concept). This model
// is the logistics/audit record itself.

model Warehouse {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  code       String?
  totalRacks Int      @default(0)
  address    String?
  manager    String?
  createdAt  DateTime @default(now())

  transfersFrom WarehouseTransfer[] @relation("SourceWarehouse")
  transfersTo   WarehouseTransfer[] @relation("DestinationWarehouse")
  racks         WarehouseRack[]
  damageReports WarehouseDamageReport[]

  @@map("warehouses")
}

enum WarehouseTransferStatus {
  IN_TRANSIT
  COMPLETED
}

model WarehouseTransfer {
  id                     String                   @id @default(cuid())
  tenantId               String
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id])
  transferNumber         String
  sourceWarehouseId      String
  sourceWarehouse        Warehouse                @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouseId String
  destinationWarehouse   Warehouse                @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  totalValuation         Decimal                  @default(0) @db.Decimal(12, 2)
  carrier                String?
  status                 WarehouseTransferStatus  @default(IN_TRANSIT)
  createdAt              DateTime                 @default(now())

  items WarehouseTransferItem[]

  @@unique([tenantId, transferNumber])
  @@map("warehouse_transfers")
}

model WarehouseTransferItem {
  id                  String            @id @default(cuid())
  warehouseTransferId String
  warehouseTransfer   WarehouseTransfer @relation(fields: [warehouseTransferId], references: [id])
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  qty                 Int

  @@map("warehouse_transfer_items")
}

// ---------- Offline synchronization ----------
// One row per POS terminal (web-pos browser profile or desktop-pos install),
// keyed by a client-generated deviceId that survives logout/login so an
// admin's "sync status" view reads as one continuous terminal, not a new row
// every shift.

model SyncDevice {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id])
  deviceId     String
  label        String?
  pendingCount Int       @default(0)
  lastSyncAt   DateTime?
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  // Telemetry reported with each heartbeat (all optional — browsers can't
  // always see battery or OS details).
  platform       String?
  osVersion      String?
  appVersion     String?
  batteryPercent Int?
  peripherals    String[]  @default([])

  @@unique([tenantId, deviceId])
  @@map("sync_devices")
}

enum SyncConflictKind {
  INSUFFICIENT_STOCK
}

enum SyncConflictStatus {
  OPEN
  RESOLVED
}

// A queued offline sale that couldn't be honestly replayed once the device
// came back online — e.g. another terminal already sold the last unit while
// this one was offline. Recorded server-side (rather than left to die in one
// device's local IndexedDB/SQLite) so a manager can see and resolve it from
// any terminal, and so it survives that device being wiped or replaced.
model SyncConflict {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  storeId        String
  store          Store               @relation(fields: [storeId], references: [id])
  deviceId       String
  idempotencyKey String
  kind           SyncConflictKind    @default(INSUFFICIENT_STOCK)
  reason         String
  payload        Json
  status         SyncConflictStatus  @default(OPEN)
  resolvedBy     String?
  resolutionNote String?
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?

  @@unique([tenantId, idempotencyKey])
  @@map("sync_conflicts")
}

// ---------- Sales documents (Module 7) ----------

enum SalesQuoteKind {
  QUOTATION
  ESTIMATE
}

enum SalesQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

// Quotations and estimates are the same document in this domain — a
// non-binding pre-sale price quote with an expiry and an accept/reject/
// convert lifecycle — so one model with a `kind` discriminator instead of
// two near-identical tables, route files, and UI pages.
model SalesQuote {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  storeId            String
  store              Store             @relation(fields: [storeId], references: [id])
  quoteNumber        String
  kind               SalesQuoteKind    @default(QUOTATION)
  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id])
  customerName       String            @default("Walk-in Customer")
  status             SalesQuoteStatus  @default(DRAFT)
  validUntil         DateTime?
  notes              String?
  subtotal           Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal           @default(0) @db.Decimal(12, 2)
  total              Decimal           @default(0) @db.Decimal(12, 2)
  convertedInvoiceId String?
  convertedInvoice   Invoice?          @relation(fields: [convertedInvoiceId], references: [id])
  createdAt          DateTime          @default(now())

  items SalesQuoteItem[]

  @@unique([tenantId, quoteNumber])
  @@map("sales_quotes")
}

model SalesQuoteItem {
  id           String     @id @default(cuid())
  salesQuoteId String
  salesQuote   SalesQuote @relation(fields: [salesQuoteId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  price        Decimal    @db.Decimal(12, 2)
  gstRate      Decimal    @db.Decimal(5, 2)
  total        Decimal    @db.Decimal(12, 2)

  @@map("sales_quote_items")
}

enum DeliveryChallanStatus {
  DRAFT
  DISPATCHED
  DELIVERED
  CANCELLED
}

// Proof-of-dispatch for goods leaving a store ahead of (or without) a formal
// tax invoice — dispatching one is a real stock movement, guarded the same
// way checkout guards against overselling.
model DeliveryChallan {
  id              String                 @id @default(cuid())
  tenantId        String
  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  storeId         String
  store           Store                  @relation(fields: [storeId], references: [id])
  challanNumber   String
  customerId      String?
  customer        Customer?              @relation(fields: [customerId], references: [id])
  customerName    String                 @default("Walk-in Customer")
  status          DeliveryChallanStatus  @default(DRAFT)
  vehicleNumber   String?
  transporterName String?
  dispatchedAt    DateTime?
  linkedInvoiceId String?
  linkedInvoice   Invoice?               @relation(fields: [linkedInvoiceId], references: [id])
  notes           String?
  createdAt       DateTime               @default(now())

  items DeliveryChallanItem[]

  @@unique([tenantId, challanNumber])
  @@map("delivery_challans")
}

model DeliveryChallanItem {
  id                String          @id @default(cuid())
  deliveryChallanId String
  deliveryChallan   DeliveryChallan @relation(fields: [deliveryChallanId], references: [id])
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Int

  @@map("delivery_challan_items")
}

enum CreditDebitNoteStatus {
  ISSUED
  CANCELLED
}

// A formal, itemized tax document against a specific invoice — more granular
// than the existing whole-invoice /invoices/:id/refund (which just flips
// status): a credit note can cover a partial return and restocks exactly the
// quantities it lists.
model CreditNote {
  id               String                @id @default(cuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  storeId          String
  store            Store                 @relation(fields: [storeId], references: [id])
  creditNoteNumber String
  invoiceId        String
  invoice          Invoice               @relation(fields: [invoiceId], references: [id])
  customerName     String
  reason           String
  status           CreditDebitNoteStatus @default(ISSUED)
  subtotal         Decimal               @default(0) @db.Decimal(12, 2)
  taxTotal         Decimal               @default(0) @db.Decimal(12, 2)
  total            Decimal               @default(0) @db.Decimal(12, 2)
  createdAt        DateTime              @default(now())

  items CreditNoteItem[]

  @@unique([tenantId, creditNoteNumber])
  @@map("credit_notes")
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  price        Decimal    @db.Decimal(12, 2)
  gstRate      Decimal    @db.Decimal(5, 2)
  total        Decimal    @db.Decimal(12, 2)

  @@map("credit_note_items")
}

// A debit note covers additional charges billed after the original invoice
// (a freight correction, a shortfall found at delivery) — record-only: unlike
// a credit note it has no goods to restock, just an amount owed.
model DebitNote {
  id              String                @id @default(cuid())
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  storeId         String
  store           Store                 @relation(fields: [storeId], references: [id])
  debitNoteNumber String
  invoiceId       String
  invoice         Invoice               @relation(fields: [invoiceId], references: [id])
  customerName    String
  reason          String
  amount          Decimal               @db.Decimal(12, 2)
  status          CreditDebitNoteStatus @default(ISSUED)
  createdAt       DateTime              @default(now())

  @@unique([tenantId, debitNoteNumber])
  @@map("debit_notes")
}

// ---------- Purchase: GRN, returns, vendor ledger (Module 6) ----------

// A real inward-goods record, separate from the PO itself — a PO can be
// received across several shipments, each with its own GRN. The stock
// actually moves here, not when the PO is created.
model GoodsReceivedNote {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  grnNumber       String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  receivedBy      String
  notes           String?
  createdAt       DateTime      @default(now())

  items          GoodsReceivedNoteItem[]
  productBatches ProductBatch[]
  productSerials ProductSerial[]

  @@unique([tenantId, grnNumber])
  @@map("goods_received_notes")
}

model GoodsReceivedNoteItem {
  id                  String            @id @default(cuid())
  goodsReceivedNoteId String
  goodsReceivedNote   GoodsReceivedNote @relation(fields: [goodsReceivedNoteId], references: [id])
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  receivedQty         Int

  @@map("goods_received_note_items")
}

enum PurchaseReturnStatus {
  ISSUED
  CANCELLED
}

// Goods going back to the supplier — the inverse stock movement of a GRN,
// and (via the vendor ledger below) a credit against what's owed them.
model PurchaseReturn {
  id              String               @id @default(cuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  returnNumber    String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  reason          String
  status          PurchaseReturnStatus @default(ISSUED)
  totalValue      Decimal              @default(0) @db.Decimal(12, 2)
  createdAt       DateTime             @default(now())

  items PurchaseReturnItem[]

  @@unique([tenantId, returnNumber])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 2)

  @@map("purchase_return_items")
}

enum SupplierPaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

// The real vendor ledger entry that replaces the old "PARTIAL = half owed"
// approximation — an actual payment against a supplier's outstanding balance.
model SupplierPayment {
  id              String                @id @default(cuid())
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  supplierId      String
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  amount          Decimal               @db.Decimal(12, 2)
  method          SupplierPaymentMethod @default(BANK_TRANSFER)
  reference       String?
  notes           String?
  paidAt          DateTime              @default(now())

  @@map("supplier_payments")
}

// ---------- Inventory: batches, serials, bundles (Module 5) ----------

// A specific lot received on a specific date, with its own expiry — the
// FEFO (first-expiry-first-out) breakdown behind Product.stockQty, which
// stays the simple aggregate everything else already reads.
model ProductBatch {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  batchNumber         String
  quantity            Int
  costPrice           Decimal            @db.Decimal(12, 2)
  expiryDate          DateTime?
  receivedAt           DateTime          @default(now())
  goodsReceivedNoteId String?
  goodsReceivedNote   GoodsReceivedNote? @relation(fields: [goodsReceivedNoteId], references: [id])
  createdAt           DateTime           @default(now())

  @@unique([tenantId, productId, batchNumber])
  @@map("product_batches")
}

enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
  DAMAGED
}

// One row per physical unit of a serialized product (electronics, appliances,
// anything sold under warranty) — tracked individually rather than as a bare
// quantity.
model ProductSerial {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  serialNumber        String
  status              SerialStatus       @default(IN_STOCK)
  invoiceId           String?
  invoice             Invoice?           @relation(fields: [invoiceId], references: [id])
  goodsReceivedNoteId String?
  goodsReceivedNote   GoodsReceivedNote? @relation(fields: [goodsReceivedNoteId], references: [id])
  createdAt           DateTime           @default(now())

  @@unique([tenantId, productId, serialNumber])
  @@map("product_serials")
}

// Composition of a combo/bundle product — selling the bundle decrements each
// component's own stock instead of the bundle carrying stock of its own.
model ProductBundleItem {
  id                 String  @id @default(cuid())
  tenantId           String
  tenant             Tenant  @relation(fields: [tenantId], references: [id])
  bundleProductId    String
  bundleProduct      Product @relation("BundleComponents", fields: [bundleProductId], references: [id])
  componentProductId String
  componentProduct   Product @relation("ComponentOfBundles", fields: [componentProductId], references: [id])
  quantity           Int

  @@unique([bundleProductId, componentProductId])
  @@map("product_bundle_items")
}

// ---------- Warehouse: racks, damage (Module 8) ----------

// A physical shelving location inside a warehouse — Warehouse.totalRacks used
// to be just a headcount; this is the real "which rack is SKU X actually on"
// answer.
model WarehouseRack {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  code        String
  capacity    Int?
  createdAt   DateTime  @default(now())

  items         WarehouseRackItem[]
  damageReports WarehouseDamageReport[]

  @@unique([warehouseId, code])
  @@map("warehouse_racks")
}

model WarehouseRackItem {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  rackId    String
  rack      WarehouseRack @relation(fields: [rackId], references: [id])
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int           @default(0)
  updatedAt DateTime      @updatedAt

  @@unique([rackId, productId])
  @@map("warehouse_rack_items")
}

// A write-off against a specific warehouse (and optionally a specific rack)
// — the actual stock effect reuses StockAdjustment (same audit log every
// other shrinkage/damage entry already shows up in), this is the
// warehouse-specific context (which facility, which rack) around it.
model WarehouseDamageReport {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  rackId      String?
  rack        WarehouseRack? @relation(fields: [rackId], references: [id])
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  quantity    Int
  reason      String
  reportedBy  String
  valueImpact Decimal        @default(0) @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())

  @@map("warehouse_damage_reports")
}

// ---------- Customer: wallet, membership, birthday offers (Module 9) ----------

enum WalletTransactionType {
  TOP_UP
  REDEEM
  REFUND
  BIRTHDAY_BONUS
}

// A real store-credit ledger — every top-up and redemption is its own row,
// Customer.walletBalance is just the running total, same relationship
// StockAdjustment has to Product.stockQty.
model CustomerWalletTransaction {
  id         String                @id @default(cuid())
  tenantId   String
  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  customerId String
  customer   Customer              @relation(fields: [customerId], references: [id])
  type       WalletTransactionType
  amount     Decimal               @db.Decimal(12, 2)
  invoiceId  String?
  invoice    Invoice?              @relation(fields: [invoiceId], references: [id])
  note       String?
  createdAt  DateTime              @default(now())

  @@map("customer_wallet_transactions")
}

// A real, tenant-configurable paid tier — replaces the hardcoded
// STANDARD/SILVER/GOLD/VIP_DIAMOND discount table that used to live only in
// the POS frontend as a placeholder. Enrolling a customer here is what
// actually earns them a checkout discount now, not just their CustomerTier
// label.
model MembershipPlan {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  name            String
  tier            CustomerTier
  annualFee       Decimal      @default(0) @db.Decimal(12, 2)
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)
  benefits        String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())

  customers Customer[]

  @@unique([tenantId, name])
  @@map("membership_plans")
}

// ---------- Scheduled analytics reports ----------

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportFormat {
  PDF
  XLSX
}

// Emailed analytics report (Reports & Analytics page → "Schedule"). The
// reporting-service cron sends each due schedule's previous period.
model ReportSchedule {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  email     String
  frequency ReportFrequency
  format    ReportFormat    @default(PDF)
  // Subset of: kpi, topSku, gst
  modules   String[]
  storeId   String?
  isActive  Boolean         @default(true)
  lastRunAt DateTime?
  createdBy String?
  createdAt DateTime        @default(now())

  @@index([tenantId])
  @@map("report_schedules")
}
