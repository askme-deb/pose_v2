// PosPe — core multi-tenant schema (starter).
// Each business-domain service (billing, inventory, purchase, sales, ...)
// extends this schema with its own models as it's built out.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- SaaS / Tenant management ----------

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Tenant {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  plan         SubscriptionPlan  @default(STARTER)
  status       TenantStatus      @default(TRIAL)
  whiteLabel   Boolean           @default(false)
  customDomain String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  stores           Store[]
  users            User[]
  products         Product[]
  brands           Brand[]
  stockAdjustments StockAdjustment[]
  customers        Customer[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]

  @@map("tenants")
}

enum UserRole {
  TENANT_OWNER
  BRANCH_ADMIN
  STORE_MANAGER
  CASHIER
  ACCOUNTANT
  INVENTORY_MANAGER
  SALES_EXECUTIVE
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  name         String
  email        String
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([tenantId, email])
  @@map("users")
}

// ---------- Store / Warehouse ----------

model Store {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  address   String?
  gstin     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users      User[]
  invoices   Invoice[]
  stockItems StockItem[]

  @@map("stores")
}

// ---------- Inventory ----------

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  gstRate     Decimal   @default(0) @db.Decimal(5, 2)
  description String?
  imageUrl    String?
  products    Product[]

  @@map("categories")
}

model Brand {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  countryOfOrigin String?
  // Simple scalar array rather than a join table — matches the current UI's
  // flat multi-select and keeps this in step with the Category model's
  // similarly minimal shape. Revisit if brand/category start needing more
  // than an id list (ordering, per-category metadata, etc).
  categoryIds     String[] @default([])
  createdAt       DateTime @default(now())

  @@map("brands")
}

model Product {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  name       String
  sku        String
  barcode    String?
  hsnCode    String?
  unit       String   @default("PCS")
  mrp        Decimal  @default(0) @db.Decimal(12, 2)
  price      Decimal  @default(0) @db.Decimal(12, 2)
  costPrice  Decimal  @default(0) @db.Decimal(12, 2)
  gstRate    Decimal  @default(0) @db.Decimal(5, 2)
  imageUrl   String?
  // Single-location stock for now (matches the current UI, which has no multi-branch
  // stock breakdown yet). The StockItem model below already supports per-store
  // allocation for when that UI is built; it's just not wired up to this field yet.
  stockQty     Int      @default(0)
  minThreshold Int      @default(0)
  createdAt  DateTime @default(now())

  stockItems         StockItem[]
  invoiceItems       InvoiceItem[]
  stockAdjustments   StockAdjustment[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([tenantId, sku])
  @@map("products")
}

enum AdjustmentAction {
  ADD
  SUBTRACT
}

enum AdjustmentStatus {
  PENDING
  APPROVED
}

model StockAdjustment {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  productId   String
  product     Product          @relation(fields: [productId], references: [id])
  action      AdjustmentAction
  qty         Int
  reasonCode  String
  auditor     String
  valueImpact Decimal          @default(0) @db.Decimal(12, 2)
  status      AdjustmentStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@map("stock_adjustments")
}

model StockItem {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(0)
  reorderAt Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([storeId, productId])
  @@map("stock_items")
}

// ---------- Customers / Suppliers ----------

enum CustomerTier {
  STANDARD
  SILVER
  GOLD
  VIP_DIAMOND
}

model Customer {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  name          String
  phone         String?
  email         String?
  tier          CustomerTier @default(STANDARD)
  loyaltyPoints Int          @default(0)
  createdAt     DateTime     @default(now())

  invoices Invoice[]

  @@map("customers")
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  contactPerson String?
  phone     String?
  email     String?
  gstin     String?
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

enum PoPaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  poNumber             String
  totalAmount          Decimal             @default(0) @db.Decimal(12, 2)
  expectedDeliveryDate DateTime
  paymentStatus        PoPaymentStatus     @default(UNPAID)
  orderStatus          PurchaseOrderStatus @default(PENDING)
  createdAt            DateTime            @default(now())

  items PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  qty             Int
  unitPrice       Decimal       @db.Decimal(12, 2)

  @@map("purchase_order_items")
}

// ---------- Billing ----------

enum InvoiceStatus {
  DRAFT
  HELD
  PAID
  PARTIALLY_PAID
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  CASH
}

model Invoice {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  // Snapshot of the billed name at sale time — real receipts print this even for
  // walk-in customers with no CRM record, and it shouldn't retroactively change
  // if the linked Customer is later renamed.
  customerName  String        @default("Walk-in Customer")
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  paymentMethod PaymentMethod @default(CASH)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())

  items InvoiceItem[]

  @@unique([storeId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  gstRate   Decimal @db.Decimal(5, 2)
  total     Decimal @db.Decimal(12, 2)

  @@map("invoice_items")
}
