{
  "name": "@pospe/database",
  "private": true,
  "version": "0.1.0",
  "description": "Shared Prisma schema, migrations and generated client for all services",
  "main": "prisma/client.ts",
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1"
  },
  "devDependencies": {
    "prisma": "^5.21.1",
    "typescript": "^5.6.3"
  }
}
